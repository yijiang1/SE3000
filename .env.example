# SE 3000 API Keys
# All keys are optional — the app includes high-fidelity offline synthesizers
# for every feature, and falls back to them automatically if a key is missing
# or a provider call fails. Add only the providers you actually have keys for;
# the app tries them in priority order and falls back down the chain.

# ── Text generation (lesson content, IEP goals, worksheets, etc.) ──────────
# Priority order: Gemini -> DeepSeek -> Kimi -> OpenAI (configurable on the
# Settings page). Any subset may be configured.

# Google Gemini (also used for the Veo/Lyria-branded storyboard & lyrics text)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek (OpenAI-compatible; https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Kimi / Moonshot AI (OpenAI-compatible; https://platform.moonshot.cn or platform.moonshot.ai)
MOONSHOT_API_KEY=your_moonshot_api_key_here
# Only needed if you're on the global platform.moonshot.ai console instead of
# the China platform.moonshot.cn console (defaults to the .cn base URL):
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# OpenAI (also used for narration TTS and as a text-generation fallback)
OPENAI_API_KEY=your_openai_api_key_here

# ── Text-to-speech narration ────────────────────────────────────────────────
# Priority order: OpenAI TTS -> MiniMax Speech.

# MiniMax (T2A v2 speech + video + music; https://platform.minimax.io)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here

# ── Real video generation ───────────────────────────────────────────────────
# Priority order: MiniMax Hailuo -> Kling. Without either configured, the
# video generator still produces a Veo-style animated storyboard script (text
# only, no real video file) using the text-generation chain above.

# Kling AI (https://klingai.com/dev)
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# ── Real music generation ───────────────────────────────────────────────────
# Uses MINIMAX_API_KEY / MINIMAX_GROUP_ID above. Without it configured, the
# music generator still produces lyrics/structure (text only, no real audio)
# using the text-generation chain above.
